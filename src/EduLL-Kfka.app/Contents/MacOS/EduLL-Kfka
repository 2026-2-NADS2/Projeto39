#!/bin/zsh
export PATH="/usr/local/bin:/opt/homebrew/bin:$HOME/.nvm/versions/node/$(ls $HOME/.nvm/versions/node 2>/dev/null | tail -n 1)/bin:$PATH"

# Localiza a pasta raiz do projeto (3 níveis acima de EduLL-Kfka.app/Contents/MacOS)
APP_ROOT="$(cd "$(dirname "$0")/../../.." && pwd)"
cd "$APP_ROOT"

if ! curl -s http://localhost:3001/api/health >/dev/null 2>&1; then
  nohup node "$APP_ROOT/backend/src/server.js" >/tmp/edull-kfka.log 2>&1 &
  sleep 1.2
fi

if [ -x "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" ]; then
  "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" --app="http://localhost:3001" >/dev/null 2>&1 &
else
  open "http://localhost:3001"
fi
